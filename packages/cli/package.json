{
  "name": "fresnel-icon",
  "version": "0.2.1",
  "description": "fresnel CLI: build, validate, render and export Liquid Glass app icons (.icon bundles) from the command line or CI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fresnel": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "icon",
    "app-icon",
    "liquid-glass",
    "icon-composer",
    "icns",
    "ios",
    "macos",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kajisho5/fresnel.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@resvg/resvg-js": "2.6.2",
    "fflate": "0.8.3",
    "zod": "4.3.3"
  },
  "devDependencies": {
    "@fresnel/core": "workspace:*",
    "@fresnel/render": "workspace:*",
    "tsup": "9.0.0",
    "tsx": "4.23.15"
  }
}
