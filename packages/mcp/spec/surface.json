    "icon_render": {
      "cli": "render",
      "positional": [
        "path"
      ],
      "args": {
        "path": {
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        "appearance": {
          "required": false,
          "schema": {
            "type": "string",
            "enum": [
              "default",
              "dark",
              "clear-light",
              "clear-dark",
              "tinted-light",
              "tinted-dark"
            ]
          }
        },
        "platform": {
          "required": false,
          "schema": {
            "type": "string",
            "enum": [
              "iOS",
              "macOS",
              "watchOS"
            ]
          }
        },
        "size": {
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 16,
            "maximum": 2048
          }
        },
        "mask": {
          "required": false,
          "schema": {
            "type": "string",
            "enum": [
              "squircle",
              "circle",
              "none"
            ]
          }
        },
        "tint": {
          "required": false,
          "schema": {
            "type": "string",
            "pattern": "^#(?:[0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$"
          }
        },
        "light_angle": {
          "required": false,
          "schema": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "out": {
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      },
      "output_keys": [
        "appearance"
      ]
    },
